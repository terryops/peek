#!/bin/bash
# qlmanage 替身：只接管 `qlmanage -p 文件…`（快速查看弹窗），其他用法原样放行。
REAL=/usr/bin/qlmanage
PEEK="$HOME/Applications/Peek.app/Contents/MacOS/Peek"
[[ -x "$PEEK" && -z "${PEEK_OFF:-}" && "${1:-}" == "-p" ]] || exec "$REAL" "$@"
shift
files=()
for a in "$@"; do
    case "$a" in
        -*) exec "$REAL" -p "$@" ;;
        *) [[ -f "$a" ]] || exec "$REAL" -p "$@"; files+=("$a") ;;
    esac
done
(( ${#files[@]} )) || exec "$REAL" -p "$@"
"$PEEK" -- "${files[@]}" || exec "$REAL" -p "$@"
